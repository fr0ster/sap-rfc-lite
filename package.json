{
  "name": "@mcp-abap-adt/sap-rfc-lite",
  "version": "0.3.2",
  "description": "Lightweight Node.js bindings for SAP NW RFC SDK",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "prebuilds",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild:ts": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build:ts": "tsc",
    "build:cpp": "node-gyp rebuild",
    "build": "npm run build:ts && npm run build:cpp",
    "lint": "biome check --write src",
    "lint:check": "biome check src",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "test": "node scripts/run-tests.js",
    "prepare": "husky",
    "prepack": "npm run build:ts",
    "prebuild:native": "node scripts/prebuild-native.js",
    "check:prebuilds": "node scripts/check-prebuilds.js",
    "prepublishOnly": "npm run check:prebuilds"
  },
  "config": {
    "napi_version": 8
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "prebuildify": "^6.0.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "gypfile": false,
  "prebuildTargets": [
    "linux-x64",
    "win32-x64",
    "darwin-arm64"
  ],
  "allowScripts": {
    "esbuild": false
  }
}
