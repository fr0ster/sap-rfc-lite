{
  "name": "@mcp-abap-adt/sap-rfc-lite",
  "version": "0.2.4",
  "description": "Lightweight Node.js bindings for SAP NW RFC SDK",
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "binding.gyp",
    "src",
    "lib",
    "prebuilds",
    "NOTICE",
    "CHANGELOG.md",
    "scripts/install.js",
    "scripts/prebuild-source.js"
  ],
  "scripts": {
    "install": "node scripts/install.js",
    "prebuild:ts": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build:ts": "tsc",
    "build:cpp": "node-gyp rebuild",
    "build": "npm run build:ts && npm run build:cpp",
    "lint": "npx biome check --write src",
    "lint:check": "npx biome check src",
    "format": "npx biome format --write src",
    "test": "jest --testTimeout 60000",
    "prepare": "husky",
    "prepack": "npm run build:ts",
    "prebuild:native": "prebuildify --napi --strip --tag-libc && node scripts/prebuild-record.js",
    "check:prebuilds": "node scripts/check-prebuilds.js",
    "prepublishOnly": "npm run check:prebuilds"
  },
  "config": {
    "napi_version": 8
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "prebuildify": "^6.0.1",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "gypfile": true,
  "prebuildTargets": [
    "linux-x64",
    "win32-x64",
    "darwin-arm64"
  ]
}
